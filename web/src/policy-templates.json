{
  "docs-broad": {
    "description": "Let agents keep the documentation current: Markdown under docs/ and the README, small changes, links checked. Architecture pages always go to a maintainer.",
    "mode": "shadow",
    "author": "agents",
    "harness": "",
    "conditions": {
      "all": [
        {
          "allowedFiles": [
            "^docs/.+\\.md$",
            "^README\\.md$"
          ]
        },
        {
          "maxPatchFiles": 10
        },
        {
          "maxModifiedLines": 200
        },
        {
          "holdoutChecks": [
            "Check the documentation links 🔗"
          ]
        }
      ],
      "deny": [
        {
          "protectedFiles": [
            "^docs/superpowers/.+$",
            "^docs/specs/.+$",
            "^docs/security/.+$"
          ]
        }
      ]
    },
    "requiresApproval": [
      {
        "changedFiles": [
          "^docs/architecture/.+$"
        ]
      }
    ],
    "limits": {
      "maxPerDay": 2
    },
    "monitor": {
      "followUpWindow": "168h"
    }
  },
  "deps-patch": {
    "description": "Let Renovate's patch bumps merge on their own once the release is old enough. Nothing is added, deleted or renamed, and a minor or major bump is not this class's.",
    "mode": "shadow",
    "author": "adopt",
    "adopt": {
      "logins": [
        "renovate[bot]"
      ],
      "branches": [
        "^renovate/"
      ]
    },
    "harness": "",
    "conditions": {
      "all": [
        {
          "diffShape": "semver-patch"
        },
        {
          "modifyOnly": true
        },
        {
          "maxPatchFiles": 3
        },
        {
          "maxModifiedLines": 10
        },
        {
          "releaseAgeCheck": "renovate/stability-days"
        }
      ]
    },
    "limits": {
      "maxPerDay": 2
    },
    "monitor": {
      "followUpWindow": "168h"
    }
  },
  "deps-minor": {
    "description": "Watch Renovate's minor bumps in shadow to learn how often they are safe. It decides nothing live: the factory keeps this shape in shadow only.",
    "mode": "shadow",
    "author": "adopt",
    "adopt": {
      "logins": [
        "renovate[bot]"
      ],
      "branches": [
        "^renovate/"
      ]
    },
    "harness": "",
    "conditions": {
      "all": [
        {
          "diffShape": "semver-minor"
        },
        {
          "modifyOnly": true
        },
        {
          "maxPatchFiles": 3
        },
        {
          "maxModifiedLines": 10
        },
        {
          "releaseAgeCheck": "renovate/stability-days"
        }
      ]
    },
    "monitor": {
      "followUpWindow": "168h"
    }
  },
  "generated-files": {
    "description": "Let a regeneration land when it only rewrites generated files and running the generator again gives the same result. Any other file refuses the pull request.",
    "mode": "shadow",
    "author": "agents",
    "harness": "",
    "conditions": {
      "all": [
        {
          "allowedFiles": [
            "^gen/.+$"
          ]
        },
        {
          "holdoutChecks": [
            "Regenerate and compare"
          ]
        },
        {
          "modifyOnly": true
        }
      ]
    }
  },
  "docs-or-tests": {
    "description": "One class for two kinds of small change, documentation or tests, each with its own check. A pull request that mixes the two is not this class's.",
    "mode": "shadow",
    "author": "agents",
    "harness": "",
    "conditions": {
      "all": [
        {
          "maxPatchFiles": 10
        },
        {
          "maxModifiedLines": 200
        }
      ],
      "any": [
        [
          {
            "allowedFiles": [
              "^docs/.+\\.md$"
            ]
          },
          {
            "holdoutChecks": [
              "Check the documentation links 🔗"
            ]
          }
        ],
        [
          {
            "allowedFiles": [
              "^test/.+$",
              "^.+_test\\.go$"
            ]
          },
          {
            "holdoutChecks": [
              "Tests"
            ]
          }
        ]
      ]
    },
    "limits": {
      "maxPerDay": 2
    },
    "monitor": {
      "followUpWindow": "168h"
    }
  },
  "infra-with-approval": {
    "description": "Let agents make small infrastructure changes that pass validation, never on production or security paths. Network changes wait for a maintainer's approval.",
    "mode": "shadow",
    "author": "agents",
    "harness": "",
    "conditions": {
      "all": [
        {
          "allowedFiles": [
            "^infrastructure/.+\\.(tf|yaml)$"
          ]
        },
        {
          "maxPatchFiles": 5
        },
        {
          "maxModifiedLines": 80
        },
        {
          "holdoutChecks": [
            "Validate infrastructure"
          ]
        }
      ],
      "deny": [
        {
          "protectedFiles": [
            "^infrastructure/(prod|security)/"
          ]
        }
      ]
    },
    "requiresApproval": [
      {
        "changedFiles": [
          "^infrastructure/network/.+$"
        ]
      }
    ],
    "limits": {
      "maxPerDay": 1
    },
    "monitor": {
      "followUpWindow": "168h"
    }
  }
}
