#!/bin/sh
# gh with the run's installation token, minted through identity-proxy :4001 by
# git-credential-agent and held only in its in-memory cache (design §5).
#
# Under hardening H2 the factory applies a run's pull request, comments, labels and issues
# (SAFE_OUTPUTS, set from the claim, HR14): gh's writes of an enforced type are turned away to the
# matching output tool, exit 3, before any token is minted. This is advisory: `gh api`, curl or
# gh-real with a token from git-credential-agent go round it. The role policy's
# pull_requests: read is the boundary, and the factory's tracer reports any direct write. Without
# SAFE_OUTPUTS nothing here applies.
if [ -n "$SAFE_OUTPUTS" ]; then
  refuse() {
    case ",$SAFE_OUTPUTS," in
      *",$1,"*)
        echo "gh $2: the factory applies this run's $1 output: use output_$1" >&2
        exit 3
        ;;
    esac
  }
  case "$2" in
    -R | --repo) sub="$4" ;;
    -R?* | --repo=*) sub="$3" ;;
    *) sub="$2" ;;
  esac
  labelled=
  for a in "$@"; do
    case "$a" in --add-label* | --remove-label*) labelled=1 ;; esac
  done
  case "$1 $sub" in
    "pr create" | "pr new" | "pr ready" | "pr close" | "pr reopen") refuse pr "pr $sub" ;;
    "pr review") refuse comment "pr review" ;;
    "issue close" | "issue reopen") refuse issue "issue $sub" ;;
    "pr edit")
      [ -n "$labelled" ] && refuse labels "pr edit --add-label"
      refuse pr "pr edit"
      ;;
    "pr comment" | "issue comment") refuse comment "$1 comment" ;;
    "issue create" | "issue new") refuse issue "issue $sub" ;;
    "issue edit")
      [ -n "$labelled" ] && refuse labels "issue edit --add-label"
      refuse issue "issue edit"
      ;;
  esac
  case "$1 $2" in
    "label list" | "label view") ;; # reads
    label\ *) refuse labels "label $2" ;;
  esac
fi
GH_TOKEN="$(/usr/local/bin/git-credential-agent token)" || exit 1
export GH_TOKEN
# `gh pr create` (alias `new`, also after `-R`/`--repo`) gets the run's
# provenance footer (SP2 design §5).
if [ "$1" = pr ]; then
  case "$2" in
    -R | --repo) sub="$4" ;;
    -R?* | --repo=*) sub="$3" ;;
    *) sub="$2" ;;
  esac
  case "$sub" in
    create | new) exec /opt/agent/pr_footer.py "$@" ;;
  esac
fi
exec /usr/local/lib/gh-real "$@"
