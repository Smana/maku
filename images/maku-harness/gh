#!/bin/sh
# gh with the run's installation token, minted through identity-proxy :4001 by
# git-credential-agent and held only in its in-memory cache (design §5).
#
# Under hardening H2 the factory applies a run's pull request, comments, labels and issues
# (SAFE_OUTPUTS, set from the claim, HR14): gh's writes of an enforced type are turned away to the
# matching output tool, exit 3, before any token is minted. This is advisory: `gh api`, curl or
# gh-real with a token from git-credential-agent go round it. The role policy's
# pull_requests: read is the boundary, and the factory's tracer reports any direct write. Without
# SAFE_OUTPUTS nothing here applies.
#
# Under hardening H4 (FORGE_READ=1, a run of a repository in mode enforce, HR37) the run reads its
# issue, pull request and checks through forge_read, filtered by the factory: gh's forge reads and
# `gh api` exit 3 and name the tool. Advisory too: the sandbox has no api.github.com egress, which
# is what holds.
if [ "$FORGE_READ" = 1 ]; then
  case "$2" in
    -R | --repo) sub="$4" ;;
    -R?* | --repo=*) sub="$3" ;;
    *) sub="$2" ;;
  esac
  case "$1 $sub" in
    "issue view" | "issue list" | "pr view" | "pr checks" | "pr list" | "run view" | "run list" | api\ *)
      echo "gh $1 $sub: use forge_read (target issue, pr or checks)" >&2
      exit 3
      ;;
    "pr diff")
      echo "gh pr diff: use git diff origin/<base>...HEAD" >&2
      exit 3
      ;;
  esac
  if [ "$1" = api ]; then
    echo "gh api: use forge_read (target issue, pr or checks)" >&2
    exit 3
  fi
fi
# Actions job logs: api.github.com answers a log read with a redirect to GitHub's log storage
# (productionresultssa*.blob.core.windows.net, results-receiver.actions.githubusercontent.com), which
# no run's egress reaches: Azure blob storage would need a wildcard over every tenant. Say so at once,
# instead of a refused redirect the run cannot explain. Server-side reads are tracked in maku#804.
logs=
case "$1" in
  run) for a in "$@"; do case "$a" in --log | --log-failed) logs=1 ;; esac; done ;;
  api) for a in "$@"; do case "$a" in */actions/jobs/*/logs | */actions/runs/*/logs | */actions/runs/*/attempts/*/logs) logs=1 ;; esac; done ;;
esac
if [ -n "$logs" ]; then
  echo "gh: Actions job logs are stored on hosts this run cannot reach (maku#804). Read the failed check from 'gh pr checks' or 'gh run view <id>' without --log, and reproduce it with agent-checks or the repository's own commands" >&2
  exit 3
fi
if [ -n "$SAFE_OUTPUTS" ]; then
  refuse() {
    case ",$SAFE_OUTPUTS," in
      *",$1,"*)
        echo "gh $2: the factory applies this run's $1 output: use output_$1" >&2
        exit 3
        ;;
    esac
  }
  case "$2" in
    -R | --repo) sub="$4" ;;
    -R?* | --repo=*) sub="$3" ;;
    *) sub="$2" ;;
  esac
  labelled=
  for a in "$@"; do
    case "$a" in --add-label* | --remove-label*) labelled=1 ;; esac
  done
  case "$1 $sub" in
    "pr create" | "pr new" | "pr ready" | "pr close" | "pr reopen") refuse pr "pr $sub" ;;
    "pr review") refuse comment "pr review" ;;
    "issue close" | "issue reopen") refuse issue "issue $sub" ;;
    "pr edit")
      [ -n "$labelled" ] && refuse labels "pr edit --add-label"
      refuse pr "pr edit"
      ;;
    "pr comment" | "issue comment") refuse comment "$1 comment" ;;
    "issue create" | "issue new") refuse issue "issue $sub" ;;
    "issue edit")
      [ -n "$labelled" ] && refuse labels "issue edit --add-label"
      refuse issue "issue edit"
      ;;
  esac
  case "$1 $2" in
    "label list" | "label view") ;; # reads
    label\ *) refuse labels "label $2" ;;
  esac
fi
GH_TOKEN="$(/usr/local/bin/git-credential-agent token)" || exit 1
export GH_TOKEN
# `gh pr create` (alias `new`, also after `-R`/`--repo`) gets the run's
# provenance footer (SP2 design §5).
if [ "$1" = pr ]; then
  case "$2" in
    -R | --repo) sub="$4" ;;
    -R?* | --repo=*) sub="$3" ;;
    *) sub="$2" ;;
  esac
  case "$sub" in
    create | new) exec /opt/agent/pr_footer.py "$@" ;;
  esac
fi
exec /usr/local/lib/gh-real "$@"
