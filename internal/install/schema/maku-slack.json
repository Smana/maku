{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "maku-slack values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {"type": "object"},
    "enabled": {"description": "The umbrella's condition (slack.enabled).", "type": "boolean"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "e2e": {"type": "object", "additionalProperties": false, "properties": {"unpinnedImages": {"type": "boolean"}}},
    "config": {"description": "The App's config, verbatim: teamID, channels, proposals.", "type": "object"},
    "brokerURL": {"type": "string", "pattern": "^(https?://[^\\s/]+)?$"},
    "roomsURL": {"type": "string", "pattern": "^(https?://[^\\s]+)?$"},
    "issuerURL": {"type": "string", "pattern": "^(https://[^\\s]+)?$"},
    "preset": {"type": "string", "enum": ["", "zitadel", "generic"]},
    "tokenURL": {"type": "string"},
    "scopes": {"type": "array", "items": {"type": "string"}},
    "audience": {"type": "string"},
    "principal": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "slackSecret": {"type": "string", "minLength": 1},
    "principalSecret": {"type": "string", "minLength": 1},
    "webhookSecret": {"type": "string", "minLength": 1},
    "extraEnv": {"type": "array", "items": {"type": "object"}},
    "extraVolumes": {"type": "array", "items": {"type": "object"}},
    "extraVolumeMounts": {"type": "array", "items": {"type": "object"}},
    "resources": {"type": "object"},
    "clusterDomain": {"type": "string"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["none", "kubernetes", "cilium"]},
        "from": {"type": "array", "items": {"type": "object"}},
        "metricsFrom": {"type": "array", "items": {"type": "object"}},
        "dns": {"type": "object", "additionalProperties": false, "properties": {"namespace": {"type": "string"}, "labels": {"type": "object"}}},
        "apiServer": {"type": "object", "additionalProperties": false, "properties": {"cidrs": {"type": "array", "items": {"type": "string"}}, "ports": {"type": "array", "items": {"type": "integer"}}}},
        "privateCIDRs": {"type": "array", "items": {"type": "string"}},
        "idp": {"type": "object", "additionalProperties": false, "properties": {"to": {"type": "array", "items": {"type": "object"}}, "port": {"type": "integer", "minimum": 0, "maximum": 65535}}},
        "extraEgress": {"type": "array", "items": {"type": "object"}},
        "cilium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fromEntities": {"type": "array", "items": {"type": "string"}},
            "metricsFromEndpoints": {"type": "array", "items": {"type": "object"}},
            "extraEgress": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    }
  }
}
