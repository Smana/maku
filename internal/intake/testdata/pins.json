{
  "comment": "One pin rule, two readers (P6, P12): intake.CheckPin reads this config through its catalogue and triage.ResolvePin reads it directly; both hold every row, so the two cannot drift. triage is the code triage answers where it differs from intake's. Since the workflow left the class (WF4), every class runs every workflow: the class is only named.",
  "repository": "Smana/demo",
  "config": {
    "templates": {
      "solo": {"roles": ["implementer"]},
      "pair": {"roles": ["implementer", "reviewer"]}
    },
    "workflows": {
      "quick": {"template": "solo"},
      "standard": {"template": "pair"},
      "careful": {"template": "pair", "tier": "frontier"},
      "loose": {},
      "none": {"template": "none"}
    },
    "repositories": [{
      "name": "Smana/demo",
      "maintainers": ["Smana"],
      "classes": {
        "docs-links": {"live": true},
        "shadowed": {"shadow": true},
        "docs": {}
      }
    }]
  },
  "pins": [
    {"name": "unknown workflow", "class": "review", "profile": "ghost", "maintainer": true, "public": true, "want": "profile_unknown"},
    {"name": "none runs nothing", "class": "review", "profile": "none", "maintainer": true, "public": true, "want": "profile_unknown"},
    {"name": "without a template", "class": "review", "profile": "loose", "maintainer": true, "public": true, "want": "profile_not_offered", "triage": ""},
    {"name": "not a maintainer", "class": "review", "profile": "careful", "maintainer": false, "public": true, "want": "not_maintainer"},
    {"name": "a live class", "class": "docs-links", "profile": "careful", "maintainer": true, "public": true, "want": ""},
    {"name": "a shadow class", "class": "shadowed", "profile": "quick", "maintainer": true, "public": true, "want": ""},
    {"name": "below the default", "class": "docs", "profile": "quick", "maintainer": true, "public": true, "want": ""},
    {"name": "internal data", "class": "review", "profile": "careful", "maintainer": true, "public": false, "want": ""},
    {"name": "the default", "class": "review", "profile": "standard", "maintainer": true, "public": true, "want": ""}
  ]
}
