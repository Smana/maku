# SPDX-License-Identifier: Apache-2.0
# The install jobs' pins (v4 step 7, PR F; IN10). Renovate bumps them; each image is by digest.
# kind v0.33.0's node images for the three latest Kubernetes minors (its release notes):
KIND_NODE_1_37=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
KIND_NODE_1_36=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KIND_NODE_1_35=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0
# Calico's manifest, the CNI that enforces the NetworkPolicies on kind (released 2026-10-28).
CALICO_VERSION=v3.32.3
# k3s for the k3d leg, as install.sh's.
K3S_IMAGE=rancher/k3s:v1.35.0-k3s1
# Postgres 16, the support floor (D26), outside the chart: install.sh's EXTERNAL_DB image.
PG_IMAGE=docker.io/library/postgres:16-alpine@sha256:f377d590e5474681d4d7838635031a2b50647923b7abfa803ce9b5ff35d5c663
# Gateway API's standard CRDs and the prometheus-operator CRDs, as identity.sh's.
GATEWAY_API=v1.2.1
PROMETHEUS_OPERATOR=v0.81.0
# The in-cluster client that plays the browser and Slack (curl), by digest.
CURL_IMAGE=docker.io/curlimages/curl:8.17.0@sha256:935d9100e9ba842cdb060de42472c7ca90cfe9a7c96e4dacb55e79e560b3ff40
