{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "maku values",
  "description": "Strict for the blocks rollout step 2 adds; every older key is free until its own step (step 1's PR4).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "broker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "oidc": {
          "description": "The OIDC client ids by Secret (v4 D8, oidc mode): mounted at /etc/room-broker/oidc, filling the human block's unset id files.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"$ref": "#/definitions/secretName"},
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "web": {"type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z0-9]+$"},
                "cli": {"type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z0-9]+$"},
                "project": {"type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z0-9]+$"}
              }
            }
          }
        },
        "database": {
          "description": "Bring your own Postgres 16 or later (v4 D9): one DSN Secret per role, their key, the database's CA, and the egress to a database outside the cluster.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "brokerSecret": {"$ref": "#/definitions/secretName"},
            "ownerSecret": {"$ref": "#/definitions/secretName"},
            "retentionSecret": {"$ref": "#/definitions/secretName"},
            "secretKey": {"type": "string", "pattern": "^[-._a-zA-Z0-9]+$"},
            "caSecret": {"$ref": "#/definitions/secretName"},
            "egress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cidrs": {"type": "array", "uniqueItems": true, "items": {"description": "An IPv4 or IPv6 CIDR.", "type": "string", "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}|[0-9a-fA-F:.]*:[0-9a-fA-F:.]*/[0-9]{1,3})$"}}
              }
            }
          }
        },
        "retention": {
          "description": "The retention CronJob (database.retentionSecret): its schedule and resources.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedule": {"type": "string", "minLength": 1},
            "resources": {"type": "object"}
          }
        },
        "modelGateway": {
          "description": "The model gateway's clients listener (plan v4 step 4, GW8): one projected token per client, the planner's and the classifier's routes filled where human leaves them unset.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$"},
            "namespace": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "audiencePrefix": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9.-]*$"}
          }
        }
      }
    },
    "runController": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gitTokens": {
          "description": "Where a run's git token comes from (D10): shared (gitSecret and gitReadSecret) or perRun (each run's own Secret, minted by the factory).",
          "type": "string",
          "enum": ["shared", "perRun"]
        },
        "tracing": {
          "description": "Run traces (v4 D21): the OTLP/HTTP endpoint each run's harness exports its span to, and the collector's pods its policy opens the endpoint's port to.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "otlpEndpoint": {
              "description": "Empty, or http(s)://<service>.<namespace>.svc.<clusterDomain>:<port>[/<path>]: an in-cluster Service by its fully qualified name, with the port the collector's pods listen on.",
              "type": "string",
              "pattern": "^(https?://[a-z0-9]([-a-z0-9]*[a-z0-9])?\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?\\.svc\\.[a-z0-9.-]+:[0-9]{1,5}(/[^?#]*)?)?$"
            },
            "collector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "namespace": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"},
                "labels": {"type": "object", "additionalProperties": {"type": "string"}}
              }
            }
          }
        },
        "model": {
          "description": "How runs reach a model (v4 step 4): secret (modelSecret, the default) or gateway (the model gateway, with the run's own token).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"type": "string", "enum": ["secret", "gateway"]},
            "gateway": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"},
                "namespace": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"},
                "ports": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "public": {"type": "integer", "minimum": 1, "maximum": 65535},
                    "internal": {"type": "integer", "minimum": 1, "maximum": 65535}
                  }
                },
                "audiencePrefix": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"},
                "aliases": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "public": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/alias"}},
                    "internal": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/alias"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "networkPolicies": {
      "description": "The network mode (D6). enabled is the old key; mode wins when set.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {"type": "string", "enum": ["", "cilium", "kubernetes", "none"]},
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "labels"],
              "properties": {
                "namespace": {"type": "string", "minLength": 1},
                "labels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
              }
            },
            "apiServerCIDRs": {"type": "array", "items": {"$ref": "#/definitions/cidr"}},
            "privateCIDRs": {"type": "array", "items": {"$ref": "#/definitions/cidr"}},
            "metricsFrom": {"description": "NetworkPolicy peers allowed to scrape :9090.", "type": "array", "items": {"type": "object"}}
          }
        }
      }
    },
    "egressProxy": {
      "description": "The egress proxy of networkPolicies.mode kubernetes (D6).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"},
        "extraPorts": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
        "maxTunnels": {"type": "integer", "minimum": 1},
        "maxTunnelsPerClient": {"type": "integer", "minimum": 1}
      }
    },
    "sandbox": {
      "description": "The run pod's sandbox (D18). The old runController.runtimeClassName and allowUnsandboxed keys stay honoured.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeClassName": {
          "description": "The sandbox RuntimeClass. Empty: runController.runtimeClassName (gvisor).",
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        },
        "unsafeAllowRunc": {
          "description": "Run agents with no RuntimeClass (runc). The demo and kind only; shown on the install banner.",
          "type": "boolean"
        }
      }
    },
    "runsQuota": {
      "description": "The ResourceQuota on runs.namespace (D16): pods, CPU and memory only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "hard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pods": {"$ref": "#/definitions/quantity"},
            "requests.cpu": {"$ref": "#/definitions/quantity"},
            "requests.memory": {"$ref": "#/definitions/quantity"},
            "limits.cpu": {"$ref": "#/definitions/quantity"},
            "limits.memory": {"$ref": "#/definitions/quantity"}
          }
        }
      }
    },
    "runPodPolicy": {
      "description": "The run pod's ValidatingAdmissionPolicy (D17).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "extraImages": {
          "description": "More image repositories a run pod may use, without tag or digest.",
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9._/:]*[a-z0-9])?$", "not": {"pattern": "(@|:[^/]*$)"}}
        }
      }
    },
    "agentRunPolicies": {
      "description": "Optional AgentRun creator and factory patch-limit policies (D17), each rendered only when set.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creators": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[^'\\\\\\s]+$"}
        },
        "factoryServiceAccount": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
        },
        "namespaces": {
          "description": "Narrow both bindings to these namespaces. Empty: every namespace, as the Kyverno originals.",
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
        }
      }
    }
  },
  "definitions": {
    "secretName": {
      "description": "A Secret's name, or empty for none.",
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$"
    },
    "alias": {
      "description": "A model alias an AgentRun's spec.model or spec.loop.judgeModel may name.",
      "type": "string",
      "enum": ["agent-default", "tier-light", "tier-standard", "tier-frontier", "kimi-frontier", "mistral-standard", "mistral-light"]
    },
    "cidr": {
      "description": "An IPv4 CIDR, such as 10.0.0.0/8.",
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "quantity": {
      "description": "A Kubernetes quantity (resource.Quantity's grammar): an integer (--set passes one) or a string such as 500m, 32Gi, 1.5Pi or 1e3.",
      "type": ["string", "integer"],
      "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(Ki|Mi|Gi|Ti|Pi|Ei|m|k|M|G|T|P|E|[eE][+-]?[0-9]+)?$"
    }
  }
}
