{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-factory values",
  "description": "The umbrella's own keys. maku and maku-factory are free objects until their values change in rollout steps 2 to 6 (PR4).",
  "definitions": {
    "parentRef": {
      "description": "A Gateway API parentRef.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string"},
        "sectionName": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "group": {"type": "string"},
        "kind": {"type": "string"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Helm's global values, passed to every subchart.",
      "type": "object"
    },
    "profile": {
      "description": "What the chart is for: demo (-f values-demo.yaml) or production (fails closed until rollout steps 2 to 6). Unset renders nothing.",
      "type": "string",
      "enum": ["", "demo", "production"]
    },
    "demoValues": {
      "description": "Set only by values-demo.yaml: the profile gate's proof that the demo's defaults are present.",
      "type": "boolean"
    },
    "clusterDomain": {
      "description": "Must equal maku.clusterDomain and maku-factory.clusterDomain.",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "demo": {
      "description": "The two Secrets the demo needs, rendered by this chart unless an existing Secret is named.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"type": "string"},
            "baseURL": {"type": "string"},
            "name": {"type": "string"},
            "judgeName": {"description": "Optional: the completion judge's model on the same endpoint (the Secret's judge_model). Empty: the judge runs on name.", "type": "string"},
            "apiKey": {"type": "string"}
          }
        },
        "githubApp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {"type": "string"},
            "id": {"description": "The App id. An integer is accepted: --set demo.githubApp.id=123 passes one.", "type": ["string", "integer"]},
            "privateKey": {"type": "string"}
          }
        }
      }
    },
    "tls": {
      "description": "The broker's CA and certificate, generated by Helm.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": {"type": "integer", "minimum": 1},
        "caName": {"type": "string", "minLength": 1}
      }
    },
    "postgres": {
      "description": "The single-replica rooms database, demo-only (v4 D9).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"description": "The bundled Postgres: demo-only (v4 D9). Off, the broker reads the DSN Secrets maku.broker.database names.", "type": "boolean"},
        "image": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
        "storage": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
        "storageClassName": {"type": "string"},
        "resources": {"type": "object"}
      }
    },
    "networkPolicies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plain": {"type": "boolean"}
      }
    },
    "monitoring": {
      "description": "Observability (D21), every switch off: monitoring objects render only when asked. Each needs the prometheus-operator CRDs (monitoring.coreos.com/v1).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "description": "ServiceMonitors for the broker and the factory; PodMonitors for the run-controller, the egress proxy (mode kubernetes) and the model-gateway proxies (maku-gateway.enabled).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "labels": {"description": "Added to every scrape object.", "type": "object", "additionalProperties": {"type": "string"}},
            "cilium": {
              "description": "maku's networkPolicies mode cilium: the scraper, admitted on :9090 of the broker and the run-controller.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fromEndpoints": {"description": "Cilium endpoint selectors of the scraper's pods.", "type": "array", "items": {"type": "object"}}
              }
            }
          }
        },
        "prometheusRule": {
          "description": "The PrometheusRule maku: the product alerts, a group per enabled component.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}},
            "disabled": {"description": "Alert names to leave out; each must name a chart alert.", "type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}, "uniqueItems": true},
            "kubeStateMetrics": {"description": "Render the rules that read kube-state-metrics' kube_* series.", "type": "boolean"},
            "docsURL": {"description": "The runbook_url base. Empty: the release's docs on GitHub.", "type": "string", "pattern": "^(https?://[^\\s\"\\\\]+)?$"}
          }
        },
        "dashboards": {
          "description": "The product dashboards, one ConfigMap each, for Grafana's dashboard sidecar or a grafana-operator configMapRef.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"description": "The sidecar's label set. Empty: grafana_dashboard: \"1\". Set: replaces it.", "type": "object", "additionalProperties": {"type": "string"}},
            "annotations": {"description": "Added to each ConfigMap, e.g. grafana_folder.", "type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "slack": {
      "description": "The Slack App (D20). Until its subchart lands (v4 step 6 PR E), enabled only adds the maku-slack alert group.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "expose": {
      "description": "Exposure (D19): one HTTPRoute or Ingress per enabled surface; none renders nothing.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["none", "httproute", "ingress"]},
        "httproute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parentRefs": {"type": "array", "items": {"$ref": "#/definitions/parentRef"}},
            "timeouts": {"description": "The web route's, rendered only when set.", "type": "object", "additionalProperties": false, "properties": {"request": {"type": "string", "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"}, "backendRequest": {"type": "string", "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"}}}
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": {"type": "string"},
            "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "web": {
          "description": "The broker's human listener, through the web front door (webProxy).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "hostnames": {"description": "RFC 1123 names.", "type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253}, "uniqueItems": true},
            "parentRefs": {"description": "httproute: replaces expose.httproute.parentRefs.", "type": "array", "items": {"$ref": "#/definitions/parentRef"}},
            "className": {"description": "ingress: replaces expose.ingress.className.", "type": "string"},
            "annotations": {"description": "ingress: merged over expose.ingress.annotations.", "type": "object", "additionalProperties": {"type": "string"}},
            "tls": {"description": "ingress: the user's Secrets.", "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["secretName"], "properties": {"secretName": {"type": "string", "minLength": 1}, "hosts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253}}}}}
          }
        },
        "slack": {
          "description": "POST /slack/events, to the Slack App (with slack.enabled).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "hostnames": {"description": "RFC 1123 names.", "type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253}, "uniqueItems": true},
            "parentRefs": {"description": "httproute: replaces expose.httproute.parentRefs.", "type": "array", "items": {"$ref": "#/definitions/parentRef"}},
            "className": {"description": "ingress: replaces expose.ingress.className.", "type": "string"},
            "annotations": {"description": "ingress: merged over expose.ingress.annotations.", "type": "object", "additionalProperties": {"type": "string"}},
            "tls": {"description": "ingress: the user's Secrets.", "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["secretName"], "properties": {"secretName": {"type": "string", "minLength": 1}, "hosts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253}}}}}
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {"description": "mode kubernetes: NetworkPolicy peers of the gateway's or ingress controller's pods.", "type": "array", "items": {"type": "object"}},
            "cilium": {"type": "object", "additionalProperties": false, "properties": {"fromEntities": {"description": "mode cilium: the gateway's or ingress's Cilium identity.", "type": "array", "items": {"type": "string", "minLength": 1}}}}
          }
        }
      }
    },
    "webProxy": {
      "description": "The web front door (D19): oauth2-proxy, its arguments derived from maku.broker.human.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"description": "By digest.", "type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
        "replicas": {"type": "integer", "minimum": 1},
        "existingSecret": {"description": "The web client and the cookie secret (D14).", "type": "string"},
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientID": {"type": "string", "minLength": 1},
            "clientSecret": {"type": "string", "minLength": 1},
            "cookieSecret": {"type": "string", "minLength": 1}
          }
        },
        "cookieRefresh": {"type": "string", "pattern": "^([0-9]{1,5}(h|m|s)){1,3}$"},
        "cookieSameSite": {"type": "string", "enum": ["strict", "lax"]},
        "metrics": {"type": "object", "additionalProperties": false, "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}},
        "extraArgs": {"description": "Appended as --key=value; a derived key is refused.", "type": "object", "additionalProperties": {"type": ["string", "boolean", "integer"]}},
        "extraEnv": {"type": "array", "items": {"type": "object"}},
        "extraVolumes": {"type": "array", "items": {"type": "object"}},
        "extraVolumeMounts": {"type": "array", "items": {"type": "object"}},
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {"type": "array", "items": {"type": "object"}},
                "port": {"type": "integer", "minimum": 0, "maximum": 65535}
              }
            }
          }
        },
        "resources": {"type": "object"}
      }
    },
    "maku": {
      "description": "The maku subchart (its own values). The keys below are also substituted into the PrometheusRule's PromQL, so they may not carry a double quote or a backslash.",
      "type": "object",
      "properties": {
        "runs": {
          "type": "object",
          "properties": {
            "namespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63}
          }
        },
        "broker": {
          "type": "object",
          "properties": {
            "human": {
              "type": "object",
              "properties": {
                "issuer": {"type": "string", "pattern": "^[^\"\\\\\\s]*$"}
              }
            }
          }
        }
      }
    },
    "maku-factory": {"type": "object"},
    "maku-gateway": {"description": "The model gateway subchart (charts/maku-gateway, its own strict schema).", "type": "object"},
    "agentgateway": {"description": "The upstream agentgateway controller subchart, v1.6.0.", "type": "object"}
  }
}
