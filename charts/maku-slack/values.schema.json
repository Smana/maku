{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "maku-slack values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {"type": "object"},
    "enabled": {"description": "The umbrella's condition (slack.enabled).", "type": "boolean"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "e2e": {"type": "object", "additionalProperties": false, "properties": {"unpinnedImages": {"type": "boolean"}}},
    "config": {"description": "The App's config, verbatim: teamID, channels, proposals.", "type": "object"},
    "brokerURL": {"type": "string", "pattern": "^(https?://[^\\s/]+)?$"},
    "roomsURL": {"type": "string", "pattern": "^(https?://[^\\s]+)?$"},
    "issuerURL": {"type": "string", "pattern": "^(https://[^\\s]+)?$"},
    "preset": {"type": "string", "enum": ["", "zitadel", "generic"]},
    "tokenURL": {"type": "string"},
    "scopes": {"type": "array", "items": {"type": "string"}},
    "audience": {"type": "string"},
    "principal": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "slackSecret": {"type": "string", "minLength": 1},
    "principalSecret": {"type": "string", "minLength": 1},
    "webhookSecret": {"type": "string", "minLength": 1},
    "resources": {"type": "object"},
    "clusterDomain": {"type": "string"}
  }
}
